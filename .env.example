# --- Server ---
PORT=4510

# --- Network config ---
# Path to the JSON file declaring relay networks. See config/networks.example.json.
NETWORKS_CONFIG_PATH=./config/networks.json

# --- Network HMAC tokens ---
# Each network in networks.json references a token by env var name (token_env).
# Set the actual token here.
# Generate strong tokens with: openssl rand -hex 32
NET_TEAM_TOKEN=replace-with-a-strong-random-token
NET_ADMIN_TO_WORKERS_TOKEN=replace-with-another-strong-random-token

# --- Delivery ---
# Default per-call timeout in milliseconds before kubectl exec is killed.
DELIVERY_TIMEOUT_MS=60000

# --- Logging ---
# Append-only JSONL audit file. Leave empty to disable.
AUDIT_LOG_FILE=./logs/relay.jsonl

# --- Pod cache ---
# How long to cache `kubectl get pods` results before re-listing.
POD_CACHE_TTL_MS=300000
